# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Agent Workspaces, Tooling & Virtual Environments
# ------------------------------------------------------------------------------
.agent/
.agents/
.antigravity/
.venv/
venv/
ENV/
env/
scratch/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. IDE, Editor & Tool Configuration
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace
.fleet/

# ------------------------------------------------------------------------------
