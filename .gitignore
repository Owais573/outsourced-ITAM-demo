# ==============================================================================
# Outsourced ITAM — Official Git Ignore Configuration
# Standard Operating Procedure & Enterprise Security Compliant
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Environment Credentials (Strictly Excluded)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*.secret
credentials.json
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 2. Node & Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
